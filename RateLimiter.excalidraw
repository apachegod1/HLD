    {
      "id": "E21xddN3qsNOmB4ffIE5G",
      "type": "text",
      "x": -27554.09361271157,
      "y": -1438.1869612880485,
      "width": 2596.07861328125,
      "height": 400,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
