    {
      "id": "KuRLpXR25Li2ExSXb_i0x",
      "type": "text",
      "x": -27577.080586507112,
      "y": -2079.873823141413,
      "width": 1437.0792236328125,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
