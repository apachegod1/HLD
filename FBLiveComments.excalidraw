    {
      "id": "IMtc9phD69cTxvtiaUiFw",
      "type": "text",
      "x": -43459.328833440246,
      "y": -5024.571280775515,
      "width": 1848.8587646484375,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a8",
