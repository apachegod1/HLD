    {
      "id": "z3bq-EVmshsHBW6sM0MiR",
      "type": "text",
      "x": -41275.37061137013,
      "y": -5414.892655205186,
      "width": 1371.3414306640625,
      "height": 125.62698000284855,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
