    {
      "id": "6kN66BicvQOKMkqrfiDdc",
      "type": "text",
      "x": -42390.596906527695,
      "y": -5994.496308326509,
      "width": 785.5394287109375,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a5",
      "roundness": null,
      "seed": 570113402,
      "version": 81,
      "versionNonce": 204494330,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784132513414,
      "link": null,
      "locked": false,
      "text": "API\n\n// post commment\nPOST /comments/:liveVideoId\nHeader: JWT | SessionToken\n{\n    \"message\": \"Cool video!\"\n} \n\n// fetching the comments\nGET /comments/:liveVideoId?cursor={last_comment_id}&pageSize=10&sort=desc\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "API\n\n// post commment\nPOST /comments/:liveVideoId\nHeader: JWT | SessionToken\n{\n    \"message\": \"Cool video!\"\n} \n\n// fetching the comments\nGET /comments/:liveVideoId?cursor={last_comment_id}&pageSize=10&sort=desc\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "xZW3MTtb_QPrjf0KEoeGL",
