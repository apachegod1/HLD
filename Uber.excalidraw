      "updated": 1784395915764,
      "link": null,
      "locked": false,
      "text": "Core Entities\n- Rider\n- Driver\n- Fare(estimated fare for a ride)\n- Ride(individual ride from rider confirmation of fare estimate untill its completion)\n- Location(Stores the real time location of drivers, lat long TS)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Core Entities\n- Rider\n- Driver\n- Fare(estimated fare for a ride)\n- Ride(individual ride from rider confirmation of fare estimate untill its completion)\n- Location(Stores the real time location of drivers, lat long TS)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "7ys3SI6ZqHY0OMogRxg0Q",
      "type": "text",
      "x": -54705.76856687816,
      "y": -5669.953655049396,
      "width": 1297.01904296875,
      "height": 875,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a2",
      "roundness": null,
      "seed": 965540393,
      "version": 498,
