    {
      "id": "3fe4Fm9O1_MBY6UeEEsUl",
      "type": "text",
      "x": -17579.709270034207,
      "y": 2755.613251498332,
      "width": 1112.159423828125,
      "height": 375,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aA",
      "roundness": null,
      "seed": 974397324,
      "version": 516,
      "versionNonce": 176290612,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783830723166,
      "link": null,
      "locked": false,
      "text": "Users should be able to view live leader board for competetions\n- A competition is \n    - 90 mins\n    - 10 probs\n    - upto 100k users\n    - scoring based on problems solved and tie using submission time\n\n- Easiest is to have a SQL query or in DynamoDB have a GSI(competitionId as partitionKey) like below\n        SELECT userId, COUNT(DISTINCT problemId) as numSolvedProblems, MIN(submittedAt) as lastSolveTime\n        FROM submissions\n        WHERE competitionId = :competitionId AND passed = true\n        GROUP BY userId\n        ORDER BY numSolvedProblems DESC, lastSolveTime ASC\n- To ensure freshness client runs this query every ~5s \n- Very Slow query, not good",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Users should be able to view live leader board for competetions\n- A competition is \n    - 90 mins\n    - 10 probs\n    - upto 100k users\n    - scoring based on problems solved and tie using submission time\n\n- Easiest is to have a SQL query or in DynamoDB have a GSI(competitionId as partitionKey) like below\n        SELECT userId, COUNT(DISTINCT problemId) as numSolvedProblems, MIN(submittedAt) as lastSolveTime\n        FROM submissions\n        WHERE competitionId = :competitionId AND passed = true\n        GROUP BY userId\n        ORDER BY numSolvedProblems DESC, lastSolveTime ASC\n- To ensure freshness client runs this query every ~5s \n- Very Slow query, not good",
      "autoResize": true,
      "lineHeight": 1.25
    },
