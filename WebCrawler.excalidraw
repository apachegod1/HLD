    {
      "id": "X5XcFfdWaSl5mVk5m6Zi_",
      "type": "text",
      "x": -55897.08809431362,
      "y": -3530.276924516602,
      "width": 1834.85888671875,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
