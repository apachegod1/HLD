      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aD",
      "roundness": null,
      "seed": 953736616,
      "version": 234,
      "versionNonce": 1172136104,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784533263814,
      "link": null,
      "locked": false,
      "text": "- Parser workers just need to keep up with crawler speed, so we can scale up/down the parser workers based on the processing queue size, this could be Lambda func, ECS on Fargate etc.\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Parser workers just need to keep up with crawler speed, so we can scale up/down the parser workers based on the processing queue size, this could be Lambda func, ECS on Fargate etc.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
