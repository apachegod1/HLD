    {
      "id": "hlEwkjfP0fhwRxRXDgdY7",
      "type": "text",
      "x": -48105.66785998794,
      "y": -1220.261271026497,
      "width": 1072.659423828125,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aE",
      "roundness": null,
      "seed": 825874244,
      "version": 179,
      "versionNonce": 1551302268,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784272972257,
      "link": null,
      "locked": false,
      "text": "How to support sliding window?\n- for the video views in the last hour:\n    - Our Flink jobs aggregate, at a minute grain, the views for each video.\n    - Whenever a new minute has passed and we're ready to write to our database, we'll...\n        - Read all of the views that happened in the minute exactly T-60 minutes ago. Call this our decrement.\n        - Write all of the views that happened in the last minute (our increment) to VideoViews.\n        - Update the VideoViewsLastHour table with difference between the increment and decrement.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "How to support sliding window?\n- for the video views in the last hour:\n    - Our Flink jobs aggregate, at a minute grain, the views for each video.\n    - Whenever a new minute has passed and we're ready to write to our database, we'll...\n        - Read all of the views that happened in the minute exactly T-60 minutes ago. Call this our decrement.\n        - Write all of the views that happened in the last minute (our increment) to VideoViews.\n        - Update the VideoViewsLastHour table with difference between the increment and decrement.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
