    {
      "id": "fcxK43s_iHS-4oi9QgJaR",
      "type": "text",
      "x": -65024.4229329133,
      "y": -3442.30316538448,
      "width": 1750.8985595703125,
      "height": 550,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
