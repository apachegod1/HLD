      "link": null,
      "locked": false,
      "text": "Ad Click Aggregator\nAn Ad Click Aggregator is a system that collects and aggregates data on ad clicks.\nIt is used by advertisers to track the performance of their ads and optimize their campaigns.\nThese ads can be displayed over website of facebook",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ad Click Aggregator\nAn Ad Click Aggregator is a system that collects and aggregates data on ad clicks.\nIt is used by advertisers to track the performance of their ads and optimize their campaigns.\nThese ads can be displayed over website of facebook",
      "autoResize": true,
      "lineHeight": 1.25
    },
