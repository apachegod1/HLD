    {
      "id": "ufmqFGFeDj191qO4GUu1A",
      "type": "text",
      "x": -10576.801087622962,
      "y": 28701.017982248726,
      "width": 501.67962646484375,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
