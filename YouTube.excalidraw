      "isDeleted": false,
      "boundElements": null,
      "updated": 1784118884861,
      "link": null,
      "locked": false,
      "text": "Non-functional Requirements\n- Availability >> Consistency\n- Low latency streaming (even if low network bandwidth)\n- High Scale (1M videos uploaded/day 100M videos watched/day)\n- Support large videos (256GB)\n- Resumable Uploads",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non-functional Requirements\n- Availability >> Consistency\n- Low latency streaming (even if low network bandwidth)\n- High Scale (1M videos uploaded/day 100M videos watched/day)\n- Support large videos (256GB)\n- Resumable Uploads",
      "autoResize": true,
      "lineHeight": 1.25
    },
