      "boundElements": null,
      "updated": 1784118694324,
      "link": null,
      "locked": false,
      "text": "Youtube\nYouTube is a video-sharing platform that allows users to upload, view, and interact with video content.\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Youtube\nYouTube is a video-sharing platform that allows users to upload, view, and interact with video content.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "COtOW8ocUF8pD8FiCggIQ",
      "type": "text",
      "x": -32812.37901955909,
      "y": -6339.748670568416,
      "width": 632.51953125,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a1",
      "roundness": null,
      "seed": 955148044,
      "version": 79,
      "versionNonce": 242575796,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784118750609,
      "link": null,
      "locked": false,
      "text": "Functional Requirements\n- Users can upload videos.\n- Users can watch (stream) videos.\n\n------- Out of Scope -------\n- Users can view information about a video, such as view counts.\n- Users can search for videos.\n- Users can comment on videos.\n- Users can see recommended videos.\n- Users can make a channel and manage their channel.\n- Users can subscribe to channels.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional Requirements\n- Users can upload videos.\n- Users can watch (stream) videos.\n\n------- Out of Scope -------\n- Users can view information about a video, such as view counts.\n- Users can search for videos.\n- Users can comment on videos.\n- Users can see recommended videos.\n- Users can make a channel and manage their channel.\n- Users can subscribe to channels.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "rhab5KozJgncGPgyQHK8k",
      "type": "text",
      "x": -32802.725507932955,
      "y": -6009.313959992561,
      "width": 627.2195434570312,
      "height": 150,
      "angle": 0,
