      "boundElements": null,
      "updated": 1784118961399,
      "link": null,
      "locked": false,
      "text": "APIs\n\n// upload a video\nPOST /upload\nRequest:\n{\n  Video,\n  VideoMetadata\n}\n\n// stream a video\nGET /videos/{videoId} -> Video & VideoMetadata",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "APIs\n\n// upload a video\nPOST /upload\nRequest:\n{\n  Video,\n  VideoMetadata\n}\n\n// stream a video\nGET /videos/{videoId} -> Video & VideoMetadata",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "3U67XfJn6KXanFtOPRaAy",
      "type": "text",
      "x": -33548.403796152736,
      "y": -5253.434175733104,
      "width": 1818.7989501953125,
      "height": 850,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a5",
