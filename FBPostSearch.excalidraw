      "updated": 1784695200101,
      "link": null,
      "locked": false,
      "text": "Hot data is the one frequently accessed, often served from memory, cold data is infrequently accessed and served from disk or remote DB\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Hot data is the one frequently accessed, often served from memory, cold data is infrequently accessed and served from disk or remote DB\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "DCu-IJBnAxRYJnnd1q-c1",
