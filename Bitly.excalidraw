      "seed": 553782054,
      "version": 291,
      "versionNonce": 1895602342,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783063489912,
      "link": null,
      "locked": false,
      "text": "8bytes\n100b\n8b\n8b\n8b\nTotal = 500bytes *1B = 500GB - No need to scale as 50TB easily handled and \nour writes are mostly handled by cache.\nEven if required do sharding on shortUrl\n- Have a DB Replica to ensure High Availability.\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "8bytes\n100b\n8b\n8b\n8b\nTotal = 500bytes *1B = 500GB - No need to scale as 50TB easily handled and \nour writes are mostly handled by cache.\nEven if required do sharding on shortUrl\n- Have a DB Replica to ensure High Availability.\n",
      "autoResize": true,
      "lineHeight": 1.25
    }
