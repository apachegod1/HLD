      "seed": 285465594,
      "version": 280,
      "versionNonce": 1046611898,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783055963785,
      "link": null,
      "locked": false,
      "text": "Functional Requirements\n- create a short url from a long url\n    - Optionally support a custom alias\n    - Optionally support an expiration time\n- be redirected to original url from the short url",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional Requirements\n- create a short url from a long url\n    - Optionally support a custom alias\n    - Optionally support an expiration time\n- be redirected to original url from the short url",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "xwbhPe699n_TKQLzb1uu8",
