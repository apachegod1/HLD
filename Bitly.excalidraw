    {
      "id": "88PhRL5jjdTmLKIu41rzX",
      "type": "text",
      "x": -111.12109375,
      "y": -218.7421875,
      "width": 469.3597106933594,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
