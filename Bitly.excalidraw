    {
      "id": "MFGb2YhBagC9eeoBF7MdM",
      "type": "text",
      "x": -118.5625,
      "y": -27.36328125,
      "width": 551.899658203125,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a7",
      "roundness": null,
      "seed": 562263034,
      "version": 411,
      "versionNonce": 1388953530,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783056248652,
      "link": null,
      "locked": false,
      "text": "Non-Functional Requirements\n- Low latency on redirects (~200ms)\n- Scale to support 100M DAU and 1B urls\n- Ensure uniqueness of short code\n- Highly available, eventual consistency for url shortening",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non-Functional Requirements\n- Low latency on redirects (~200ms)\n- Scale to support 100M DAU and 1B urls\n- Ensure uniqueness of short code\n- Highly available, eventual consistency for url shortening",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "RUb0Qj4nOhpcPvuBA3S5r",
      "type": "text",
      "x": -120.54009022844207,
      "y": 190.38701876378366,
      "width": 129.29991149902344,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a8",
