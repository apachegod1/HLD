      "seed": 363006970,
      "version": 144,
      "versionNonce": 800181926,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783056343724,
      "link": null,
      "locked": false,
      "text": "Core Entities\n- Original url\n- Short url\n- User",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Core Entities\n- Original url\n- Short url\n- User",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Vjow7U9RmzD5yXcKCM1-c",
      "type": "text",
      "x": -131.2189229920467,
      "y": 361.98483170248255,
      "width": 433.0997619628906,
      "height": 325,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a9",
      "roundness": null,
      "seed": 809379066,
      "version": 434,
      "versionNonce": 2070444346,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783056632875,
      "link": null,
      "locked": false,
      "text": "APIs\n\n// shorten a url\nPOST   /urls  ->  shortUrl\n{\n    originalUrl,\n    alias?,\n    expirationTime?\n}\n\n\n// redirection\nGET  {shortUrl}  -> Redirect to originalUrl ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "APIs\n\n// shorten a url\nPOST   /urls  ->  shortUrl\n{\n    originalUrl,\n    alias?,\n    expirationTime?\n}\n\n\n// redirection\nGET  {shortUrl}  -> Redirect to originalUrl ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "t0iQlVedcA8yfzwEcmeN6",
      "type": "text",
      "x": -132.90425501045843,
      "y": 803.43833662312,
      "width": 1503.9588623046875,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aA",
      "roundness": null,
      "seed": 1047399162,
      "version": 1056,
      "versionNonce": 1484979814,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783060792206,
      "link": null,
      "locked": false,
      "text": "Notes\n- 2 types of redirect codes, 301, 302. whenever server returns any of these codes, the browser simply redirects to the returned Url\n- 301 - permanent - i.e. client/Browser/DNS will cache this redirect and in future directly visit them when entered a short Url without hitting your service\n- 302 - temporary - No cache, each time client hits your service.\n- 302 is better for your service because you want to know how much traffic you are having, else there's no way for you to know the analytics. \n- If we wanna save on compute cost and very quick response then 301\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Notes\n- 2 types of redirect codes, 301, 302. whenever server returns any of these codes, the browser simply redirects to the returned Url\n- 301 - permanent - i.e. client/Browser/DNS will cache this redirect and in future directly visit them when entered a short Url without hitting your service\n- 302 - temporary - No cache, each time client hits your service.\n- 302 is better for your service because you want to know how much traffic you are having, else there's no way for you to know the analytics. \n- If we wanna save on compute cost and very quick response then 301\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
