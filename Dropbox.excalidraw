    {
      "id": "Jgo-l1_mkTbew_5p0vcoi",
      "type": "text",
      "x": -10728.985216764586,
      "y": 32296.53893503625,
      "width": 1391.7191162109375,
      "height": 600,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
