      "updated": 1783139487120,
      "link": null,
      "locked": false,
      "text": "APIs\n\n// upload a file\nPOST /files  ->  200\n{\n    File,\n    FileMetadata\n}\n\n\n// download a file\nGET /files/{fileId}  ->  File & FileMetadata\n\n\n// share a file\nPOST /files/{fileId}/share\nRequest:\n{\n    User[] // list of users to share with\n}\n\n\n// manually/auto sync files\nGET /files/changes?since={timestamp}  ->  ChangeEvent[]  // contains fileId, type of change(created/updated/deleted), updated metadata) ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "APIs\n\n// upload a file\nPOST /files  ->  200\n{\n    File,\n    FileMetadata\n}\n\n\n// download a file\nGET /files/{fileId}  ->  File & FileMetadata\n\n\n// share a file\nPOST /files/{fileId}/share\nRequest:\n{\n    User[] // list of users to share with\n}\n\n\n// manually/auto sync files\nGET /files/changes?since={timestamp}  ->  ChangeEvent[]  // contains fileId, type of change(created/updated/deleted), updated metadata) ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
