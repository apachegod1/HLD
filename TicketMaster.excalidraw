      "text": "TicketMaster\nTicketmaster is an online platform that allows users to purchase tickets for concerts, sports events, \ntheater, and other live entertainment.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "TicketMaster\nTicketmaster is an online platform that allows users to purchase tickets for concerts, sports events, \ntheater, and other live entertainment.",
      "autoResize": true,
      "lineHeight": 1.25
    },
